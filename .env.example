# Loomool — local dev env. Copy to `.env` and adjust. Never commit `.env`.

LOOMOOL_ENV=local

# Django
DJANGO_SECRET_KEY=replace-with-a-50-plus-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PATH=manage/

# Database
DATABASE_URL=postgresql://loomool:loomool@db:5432/loomool

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sentry (leave empty — SDK not wired in Phase 1)
SENTRY_DSN=


# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Loomool <noreply@loomool.local>
FRONTEND_BASE_URL=http://localhost:3000

# Token lifetimes
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# OTP / Rate limit
OTP_TOTP_ISSUER=Loomool
RATELIMIT_FAIL_OPEN=False

# Object storage (S3 / MinIO)
AWS_STORAGE_BUCKET_NAME=loomool-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=loomool
AWS_SECRET_ACCESS_KEY=loomool-minio-dev
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_AUTH=False
