# Loomool — local dev env. Copy to `.env` and adjust. Never commit `.env`.

LOOMOOL_ENV=local

# Django
DJANGO_SECRET_KEY=replace-with-a-50-plus-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_PATH=manage/

# Database
DATABASE_URL=postgresql://loomool:loomool@db:5432/loomool

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sentry (leave empty — SDK not wired in Phase 1)
SENTRY_DSN=